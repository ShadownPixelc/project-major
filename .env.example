# Application Settings
APP_ENV=development
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/project_major

# Vector Database Configuration (ChromaDB)
CHROMA_DB_IMPL=duckdb+parquet
CHROMA_PERSIST_DIRECTORY=./chroma_data

# GitHub API Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# AI / LLM Integration (if applicable for RAG)
OPENAI_API_KEY=your_openai_api_key